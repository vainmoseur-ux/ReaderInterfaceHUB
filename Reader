--========================================================--
-- NORMAL SKILL CHECK
--========================================================--

local PreviousVisible = false

RunService.RenderStepped:Connect(function()

    if not Enabled then

        PreviousVisible = false

        return

    end

    if not Check then
        RefreshReferences()
    end

    if not Check then
        return
    end

    local Visible =
        Check.Visible

    --====================================================--
    -- NEW SKILL CHECK
    --====================================================--

    if Visible and not PreviousVisible then

        Busy = false

        if not ScourgeActive then

            if Mode == "INSTANT" then
                InstantNormal()
            end

        end

    end

    PreviousVisible =
        Visible

    --====================================================--
    -- NORMAL SUCCESS
    --====================================================--

    if Visible and not ScourgeActive then

        if not Busy then

            local ShouldTrigger = false

            if Mode == "SUCCESS" then

                ShouldTrigger =
                    IsSuccess()

            elseif Mode == "NEUTRAL" then

                ShouldTrigger =
                    IsNeutral()

            end

            if ShouldTrigger then

                Busy = true

                TriggerAction()

                task.delay(0.07, function()

                    Busy = false

                end)

            end

        end

    end

    --====================================================--
    -- KING SCOURGE
    --====================================================--

    if ScourgeActive and Visible then

        if Mode == "SUCCESS" then

            if not Busy and IsSuccess() then

                Busy = true

                TriggerAction()

                task.delay(0.06, function()

                    Busy = false

                end)

            end

        elseif Mode == "NEUTRAL" then

            if not Busy and IsNeutral() then

                Busy = true

                TriggerAction()

                task.delay(0.06, function()

                    Busy = false

                end)

            end

        elseif Mode == "INSTANT" then

            local CurrentGoal =
                tonumber(Goal.Rotation) or 0

            local CurrentLine =
                tonumber(Line.Rotation) or 0

            local Distance =
                math.abs(
                    CurrentLine -
                    CurrentGoal
                )

            if Distance > 130 then
                Busy = false
            end

        end

    end

end)

--========================================================--
-- KING SCOURGE GOAL CHANGE DETECTOR
--========================================================--

task.spawn(function()

    local LastGoalRotation = nil

    while true do

        if Enabled
            and ScourgeActive
            and Mode == "INSTANT" then

            RefreshReferences()

            if Check
                and Check.Visible
                and Goal
                and Line then

                local CurrentGoal =
                    tonumber(Goal.Rotation) or 0

                if LastGoalRotation == nil then

                    LastGoalRotation =
                        CurrentGoal

                    InstantScourge()

                elseif
                    math.abs(
                        CurrentGoal -
                        LastGoalRotation
                    ) > 1 then

                    LastGoalRotation =
                        CurrentGoal

                    InstantScourge()

                end

            end

        else

            LastGoalRotation = nil

        end

        task.wait(0.005)

    end

end)

--========================================================--
-- AUTO PARRY
--========================================================--

local function IsKillerCharacter(character)

    if not character then
        return false
    end

    return
        character:FindFirstChild(
            "Lookscriptkiller",
            true
        ) ~= nil

end

--========================================================--
-- GET PLAYER ROOT
--========================================================--

local function GetRoot(character)

    if not character then
        return nil
    end

    return character:FindFirstChild(
        "HumanoidRootPart"
    )

end

--========================================================--
-- GET DISTANCE TO KILLER
--========================================================--

local function GetKillerDistance(character)

    local MyCharacter =
        LocalPlayer.Character

    local MyRoot =
        GetRoot(MyCharacter)

    local KillerRoot =
        GetRoot(character)

    if not MyRoot or not KillerRoot then
        return math.huge
    end

    return (
        KillerRoot.Position -
        MyRoot.Position
    ).Magnitude

end

--========================================================--
-- ORIGINAL PARRY BUTTON
--========================================================--

local function RefreshGuiMob()

    if GuiMob
        and GuiMob.Parent then

        return true

    end

    RefreshReferences()

    return GuiMob ~= nil

end

--========================================================--
-- TRIGGER ORIGINAL PARRY
--========================================================--
-- Tidak memanggil ParryClient secara langsung.
-- Tidak membuat ParryClient baru.
-- Tidak menggunakan parry Remote secara langsung.
--
-- Gui-mob tetap menjadi input yang digunakan oleh
-- ParryClient asli.
--========================================================--

local function TriggerOriginalParry()

    if not AutoParryEnabled then
        return false
    end

    if not RefreshGuiMob() then
        return false
    end

    local Now =
        os.clock()

    -- Proteksi terhadap trigger berulang
    if Now - LastParryTrigger < 0.05 then
        return false
    end

    LastParryTrigger =
        Now

    pcall(function()

        if GuiMob:IsA("GuiButton") then
            GuiMob:Activate()
        end

    end)

    if typeof(firesignal) == "function" then

        pcall(function()

            firesignal(
                GuiMob.MouseButton1Down
            )

        end)

    end

    return true

end

--========================================================--
-- ANIMATION ID
--========================================================--

local function GetAnimationId(track)

    if not track then
        return nil
    end

    local Animation =
        track.Animation

    if not Animation then
        return nil
    end

    local AnimationId =
        Animation.AnimationId

    if not AnimationId then
        return nil
    end

    return tostring(
        AnimationId
    ):match("%d+")

end

--========================================================--
-- KILLER ATTACK DETECTION
--========================================================--

local function OnKillerAnimation(
    KillerCharacter,
    Track
)

    if not AutoParryEnabled then
        return
    end

    if not IsKillerCharacter(
        KillerCharacter
    ) then
        return
    end

    local AnimationId =
        GetAnimationId(Track)

    if not AnimationId then
        return
    end

    if not AttackAnimations[
        AnimationId
    ] then

        return

    end

    local Distance =
        GetKillerDistance(
            KillerCharacter
        )

    if Distance > ParryRange then
        return
    end

    --====================================================--
    -- ATTACK CONFIRMED
    --====================================================--

    CurrentKiller =
        KillerCharacter

    KillerAttacking =
        true

    LastAttackTime =
        os.clock()

    -- Langsung trigger tanpa delay
    TriggerOriginalParry()

end

--========================================================--
-- WATCH KILLER ANIMATOR
--========================================================--

local WatchedAnimators = {}

local function WatchKiller(
    KillerCharacter
)

    if not KillerCharacter then
        return
    end

    if WatchedAnimators[
        KillerCharacter
    ] then

        return

    end

    local Humanoid =
        KillerCharacter:FindFirstChildOfClass(
            "Humanoid"
        )

    if not Humanoid then
        return
    end

    local Animator =
        Humanoid:FindFirstChildOfClass(
            "Animator"
        )

    if not Animator then
        return
    end

    WatchedAnimators[
        KillerCharacter
    ] = Animator

    Animator.AnimationPlayed:Connect(
        function(Track)

            OnKillerAnimation(
                KillerCharacter,
                Track
            )

        end
    )

end

--========================================================--
-- KILLER SCANNER
--========================================================--

task.spawn(function()

    while true do

        for _, Player in ipairs(
            Players:GetPlayers()
        ) do

            if Player ~= LocalPlayer then

                local Character =
                    Player.Character

                if Character
                    and IsKillerCharacter(
                        Character
                    ) then

                    WatchKiller(
                        Character
                    )

                end

            end

        end

        task.wait(0.1)

    end

end)

--========================================================--
-- ATTACK STATE / RANGE
--========================================================--

local function UpdateParryState()

    if not KillerAttacking then
        return
    end

    if not CurrentKiller then

        KillerAttacking = false
        return

    end

    local Distance =
        GetKillerDistance(
            CurrentKiller
        )

    if Distance > ParryRange then

        KillerAttacking = false

    end

    if os.clock() -
        LastAttackTime > 1 then

        KillerAttacking = false
        CurrentKiller = nil

    end

end

