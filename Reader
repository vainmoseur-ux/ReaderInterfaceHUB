--========================================================--
-- RANGE VISUAL UPDATE
--========================================================--

local function UpdateRangeRing()

    local Character =
        LocalPlayer.Character

    local Root =
        GetRoot(Character)

    if not Root then

        RangeRing.Transparency =
            1

        return

    end

    if not RangeVisualEnabled then

        RangeRing.Transparency =
            1

        return

    end

    RangeRing.Transparency =
        0.45

    RangeRing.Size =
        Vector3.new(
            0.08,
            ParryRange * 2,
            ParryRange * 2
        )

    RangeRing.CFrame =
        CFrame.new(
            Root.Position -
            Vector3.new(
                0,
                2.8,
                0
            )
        )
        *
        CFrame.Angles(
            0,
            0,
            math.rad(90)
        )

    --====================================================--
    -- GREEN = KILLER ATTACKING INSIDE RANGE
    -- RED = NORMAL RANGE
    --====================================================--

    if KillerAttacking
        and CurrentKiller then

        local Distance =
            GetKillerDistance(
                CurrentKiller
            )

        if Distance <= ParryRange then

            RangeRing.Color =
                Color3.fromRGB(
                    0,
                    255,
                    0
                )

            return

        end

    end

    RangeRing.Color =
        Color3.fromRGB(
            255,
            0,
            0
        )

end

