local function IsKillerCharacter(character)

    if not character then
        return false
    end

    return
        character:FindFirstChild(
            "Lookscriptkiller",
            true
        ) ~= nil

end

--========================================================--
-- GET PLAYER ROOT
--========================================================--

local function GetRoot(character)

    if not character then
        return nil
    end

    return character:FindFirstChild(
        "HumanoidRootPart"
    )

end

--========================================================--
-- GET DISTANCE TO KILLER
--========================================================--

local function GetKillerDistance(character)

    local MyCharacter =
        LocalPlayer.Character

    local MyRoot =
        GetRoot(MyCharacter)

    local KillerRoot =
        GetRoot(character)

    if not MyRoot or not KillerRoot then
        return math.huge
    end

    return (
        KillerRoot.Position -
        MyRoot.Position
    ).Magnitude

end

