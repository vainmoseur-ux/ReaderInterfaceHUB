local OldNamecall
OldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()

    if SilentAimSettings.Enabled and (method == "FireServer" or method == "InvokeServer") then
        local remoteName = string.lower(self.Name)
        local isAttack = false
        for _, name in ipairs(TargetRemotes) do
            if string.find(remoteName, name) then
                isAttack = true
                break
            end
        end

        if isAttack then
            local args = {...}
            local argCount = select("#", ...)
            local target = GetClosestSurvivor()

            if target then
                local targetPart = target.Character:FindFirstChild(SilentAimSettings.AimPart)
                if targetPart then
                    local targetPos = targetPart.Position + (targetPart.Velocity * SilentAimSettings.Prediction)
                    local myChar = LocalPlayer.Character
                    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                    local myPos = myRoot and myRoot.Position or Camera.CFrame.Position

                    local modified = false

                    for i = 1, argCount do
                        local arg = args[i]
                        if typeof(arg) == "Vector3" then
                            if arg.Magnitude > 0 and arg.Magnitude <= 2 then
                                args[i] = (targetPos - myPos).Unit
                                modified = true
                            elseif (arg - myPos).Magnitude > 8 then
                                args[i] = targetPos
                                modified = true
                            end
                        elseif typeof(arg) == "CFrame" then
                            args[i] = CFrame.lookAt(arg.Position, targetPos)
                            modified = true
                        end
                    end

                    if modified then
                        return OldNamecall(self, unpack(args, 1, argCount))
                    end
                end
            end
        end
    end

    return OldNamecall(self, ...)
end)

